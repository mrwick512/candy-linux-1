# Candy Linux package list.
# The build uses --apt-recommends false to keep the image small for a 16 GB eMMC,
# so anything the desktop needs at runtime is listed explicitly here.
# Packages whose names differ between Debian releases are installed best-effort
# by config/hooks/live/0020-candy-firmware.hook.chroot instead.

# --- live system / base ---
live-boot
live-config
live-config-systemd
sudo 
   user-setup
   xauth
   at-spi2-core
   libglib2.0-bin
locales
tzdata
console-setup
keyboard-configuration
kbd
ca-certificates
bash-completion
less
nano
curl
wget
git
rsync
zip
unzip
squashfs-tools

# --- Wi-Fi / Bluetooth (Intel Dual Band Wireless-AC 7260) ---
firmware-iwlwifi
network-manager
network-manager-gnome
wpasupplicant
wireless-regdb
iw
rfkill
bluez
blueman

# --- audio (Intel SST + MAX98090 codec -> "chtmax98090" sound card) ---
alsa-utils
alsa-ucm-conf
pipewire-audio
pavucontrol

# --- graphics (Intel HD Graphics, Bay Trail; i915 + Mesa) ---
xserver-xorg-core
xserver-xorg-input-libinput
x11-xserver-utils
libgl1-mesa-dri
libinput-tools

# --- desktop: XFCE, kept light for 2-4 GB RAM ---
lightdm
lightdm-gtk-greeter
xfce4-session
xfwm4
xfdesktop4
xfce4-panel
xfce4-settings
xfce4-appfinder
xfce4-notifyd
xfce4-power-manager
xfce4-terminal
xfce4-screenshooter
xfce4-taskmanager
xfce4-pulseaudio-plugin
xfce4-xkb-plugin
xfce4-whiskermenu-plugin
thunar
thunar-volman
thunar-archive-plugin
tumbler
mousepad
ristretto
file-roller
gvfs
udisks2
polkitd
pkexec
libpam-systemd
dbus-user-session
dbus-x11
xdg-utils
xdg-user-dirs
desktop-file-utils
shared-mime-info
adwaita-icon-theme
gnome-themes-extra
gnome-keyring
libpam-gnome-keyring
firefox-esr

# --- fonts (Latin + Arabic coverage) ---
fonts-dejavu-core
fonts-liberation
fonts-noto-core
fonts-noto-ui-core
fonts-noto-color-emoji

# --- power, memory, storage ---
tlp
powertop
systemd-zram-generator
mmc-utils
dosfstools
e2fsprogs
exfatprogs
ntfs-3g
parted
efibootmgr
grub-efi-amd64-bin
grub-pc-bin

# --- hardware debugging ---
pciutils
usbutils
lshw
dmidecode
i2c-tools
evtest
acpi
htop
