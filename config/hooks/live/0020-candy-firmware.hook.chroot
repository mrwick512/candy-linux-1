#!/bin/sh
# Best-effort extras. Package names move between Debian releases, so a missing
# one is reported in the build log but must never fail the build.
export DEBIAN_FRONTEND=noninteractive

apt-get update -q || true

# Audio firmware for the Bay Trail DSP (fw_sst_0f28.bin / SOF), Intel Bluetooth
# firmware for the 7260, a VA-API driver for Gen7 video decode, an Arabic font.
for pkg in \
	firmware-intel-sound \
	firmware-sof-signed \
	firmware-intel-misc \
	firmware-misc-nonfree \
	i965-va-driver \
	fonts-hosny-amiri
do
	if apt-get install -y --no-install-recommends "$pkg" >/dev/null 2>&1; then
		echo "candy: installed $pkg"
	else
		echo "candy: SKIPPED $pkg (not available in this release)"
	fi
done

# A polkit authentication agent is needed for graphical password prompts
# (Wi-Fi settings, mounting disks, GParted). The first name that exists wins.
for pkg in policykit-1-gnome polkit-1-gnome xfce-polkit lxpolkit; do
	if apt-get install -y --no-install-recommends "$pkg" >/dev/null 2>&1; then
		echo "candy: installed polkit agent $pkg"
		break
	fi
done

exit 0
