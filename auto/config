#!/bin/sh
# live-build configuration for Candy Linux (Dell Chromebook 11 3120, codename "candy").
# Run via `lb config`; edit the options here, not in config/ (it is regenerated).
set -e

lb config noauto \
	--distribution trixie \
	--architectures amd64 \
	--linux-flavours amd64 \
	--archive-areas "main contrib non-free-firmware" \
	--mirror-bootstrap http://deb.debian.org/debian/ \
	--mirror-binary http://deb.debian.org/debian/ \
	--security true \
	--updates true \
	--apt-recommends false \
	--apt-indices false \
	--firmware-chroot true \
	--binary-image iso-hybrid \
	--bootloaders "syslinux,grub-efi" \
	--debian-installer none \
	--memtest none \
	--win32-loader false \
	--iso-application "Candy Linux" \
	--iso-publisher "Candy Linux - custom build for Dell Chromebook 11 (candy)" \
	--iso-volume "CANDY_LINUX" \
	--bootappend-live "boot=live components quiet username=candy hostname=candy locales=en_US.UTF-8 timezone=Asia/Baghdad keyboard-model=chromebook keyboard-layouts=us,ara keyboard-options=grp:alt_shift_toggle" \
	"${@}"
